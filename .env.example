# Authentication
AUTH_SECRET=your-secret-key-here-change-in-production
NEXTAUTH_URL=http://localhost:3000

# Database
# For Render Postgres, include the SSL flag required by managed databases:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require"

# Real-time carbon data is optional.
# The app falls back to mock data if the live API is unavailable.
